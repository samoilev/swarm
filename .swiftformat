# SwiftFormat configuration for Swarm.
# Conservative on purpose: enforce whitespace/indentation consistency without
# structural or opinionated rewrites, so the format gate stays low-risk.

--swiftversion 5.9
--exclude .build,outputs

# Disable opinionated / structural rules that would churn or alter intent:
--disable enumNamespaces          # don't flip static-only structs into enums
--disable andOperator             # keep `&&` in conditions (don't force commas)
--disable trailingCommas          # leave trailing-comma style as written
--disable wrapMultilineStatementBraces
--disable redundantSelf
--disable unusedArguments          # named args used for documentation/clarity
--disable hoistPatternLet
--disable blankLinesAtStartOfScope
--disable blankLinesAtEndOfScope
--disable wrapLoopBodies           # don't force inline `for x { … }` onto extra lines
--disable wrapPropertyBodies       # leave single-line computed properties as written
# Same policy as the two above, for rules SwiftFormat added in 0.62, which are on
# by default and would rewrite ~860 single-line bodies across the codebase.
# Naming them here sets the floor at 0.62: an older binary rejects an unknown rule
# outright, so this file and SWIFTFORMAT_VERSION in ci.yml move together.
--disable wrapIfStatementBodies    # leave `if x { return }` on one line
--disable wrapIfExpressionBodies   # same, for if/switch used as an expression

# Indentation / wrapping
--indent 4
--ifdef no-indent
